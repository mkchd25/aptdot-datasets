{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.aptdot.com/data/v1/design-system-color-tokens.schema.json",
  "title": "Aptdot Open Color Palette",
  "description": "Structure of the Aptdot palette file: colour scales with multi-format values and WCAG 2 contrast results, light and dark semantic tokens, and CSS exports. The W3C DTCG token file is published separately as design-system-color-tokens.tokens.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "metadata", "palettes", "semantic", "exports"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "date_modified", "description", "license", "license_url", "schema", "source", "dtcg_file", "standards", "counts", "hues", "wcag_thresholds", "surfaces", "guarantees", "step_contrast_on_white", "conventions"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "date_modified": { "type": "string", "format": "date" },
        "description": { "type": "string", "minLength": 50 },
        "license": { "const": "CC0-1.0" },
        "license_url": { "type": "string", "format": "uri" },
        "schema": { "type": "string", "format": "uri" },
        "source": { "type": "string", "format": "uri" },
        "dtcg_file": { "type": "string", "format": "uri" },
        "standards": { "type": "object", "additionalProperties": { "type": "string" } },
        "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "hues": { "type": "object", "additionalProperties": { "type": "string" } },
        "wcag_thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["aa", "aa_large", "aaa", "aaa_large", "non_text"],
          "properties": {
            "aa": { "const": 4.5 }, "aa_large": { "const": 3 }, "aaa": { "const": 7 }, "aaa_large": { "const": 4.5 }, "non_text": { "const": 3 }
          }
        },
        "surfaces": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hex" } },
        "guarantees": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "step_contrast_on_white": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["min", "max"],
            "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
          }
        },
        "conventions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "palettes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/color" } }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": { "$ref": "#/$defs/semanticMode" },
        "dark": { "$ref": "#/$defs/semanticMode" }
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["css_variables", "tailwind_v4_theme", "semantic_css"],
      "properties": {
        "css_variables": { "type": "string" },
        "tailwind_v4_theme": { "type": "string" },
        "semantic_css": { "type": "string" }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratio", "aa", "aa_large", "aaa", "aaa_large", "non_text"],
      "properties": {
        "ratio": { "type": "number", "minimum": 1, "maximum": 21 },
        "aa": { "type": "boolean" }, "aa_large": { "type": "boolean" }, "aaa": { "type": "boolean" },
        "aaa_large": { "type": "boolean" }, "non_text": { "type": "boolean" }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "css_variable", "step", "hex", "rgb", "rgb_components", "hsl", "oklch", "oklch_components", "relative_luminance", "in_srgb_gamut", "contrast"],
      "properties": {
        "token": { "type": "string", "pattern": "^color\\.[a-z]+\\.\\d+$" },
        "css_variable": { "type": "string", "pattern": "^--color-[a-z]+-\\d+$" },
        "step": { "enum": [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950] },
        "hex": { "$ref": "#/$defs/hex" },
        "rgb": { "type": "string", "pattern": "^rgb\\(\\d{1,3} \\d{1,3} \\d{1,3}\\)$" },
        "rgb_components": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
        "hsl": { "type": "string", "pattern": "^hsl\\(\\d{1,3} \\d{1,3}% \\d{1,3}%\\)$" },
        "oklch": { "type": "string", "pattern": "^oklch\\([\\d.]+% [\\d.]+ ([\\d.]+|none)\\)$" },
        "oklch_components": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 0.5 },
            { "type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360 }
          ]
        },
        "relative_luminance": { "type": "number", "minimum": 0, "maximum": 1 },
        "in_srgb_gamut": { "const": true },
        "contrast": {
          "type": "object",
          "additionalProperties": false,
          "required": ["white", "black", "slate-50", "slate-100", "slate-900", "slate-950"],
          "properties": {
            "white": { "$ref": "#/$defs/levels" }, "black": { "$ref": "#/$defs/levels" },
            "slate-50": { "$ref": "#/$defs/levels" }, "slate-100": { "$ref": "#/$defs/levels" },
            "slate-900": { "$ref": "#/$defs/levels" }, "slate-950": { "$ref": "#/$defs/levels" }
          }
        }
      }
    },
    "semanticMode": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token", "css_variable", "references", "hex", "purpose"],
        "properties": {
          "token": { "type": "string", "pattern": "^semantic\\.(light|dark)\\.[a-z-]+$" },
          "css_variable": { "type": "string", "pattern": "^--color-[a-z-]+$" },
          "references": { "type": "string", "pattern": "^\\{color\\.[a-z]+(\\.\\d+)?\\}$" },
          "hex": { "$ref": "#/$defs/hex" },
          "purpose": { "type": "string" },
          "checked_against": { "type": "string" },
          "contrast": { "$ref": "#/$defs/levels" }
        }
      }
    }
  }
}
