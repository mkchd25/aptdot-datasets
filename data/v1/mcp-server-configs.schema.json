{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.aptdot.com/data/v1/mcp-server-configs.schema.json",
  "title": "Aptdot MCPServerConfigsMatrix",
  "type": "object",
  "required": ["metadata", "client_config_paths", "mcpServers"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["name", "version", "generated_at", "license", "target_protocol", "total_servers", "description"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "license": { "type": "string", "format": "uri" },
        "target_protocol": { "type": "string" },
        "total_servers": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" }
      }
    },
    "client_config_paths": {
      "type": "object",
      "required": ["claude_desktop", "cursor", "vscode"]
    },
    "mcpServers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["command", "args", "transport", "maintenance_status", "upstream_repo", "capabilities", "description", "security_scope", "common_pitfalls", "env"],
        "properties": {
          "command": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } },
          "transport": { "type": "string", "enum": ["stdio", "streamable-http"] },
          "maintenance_status": { "type": "string", "enum": ["actively_maintained", "community_maintained", "archived_do_not_use"] },
          "upstream_repo": { "type": "string", "format": "uri" },
          "capabilities": {
            "type": "object",
            "required": ["tools", "resources", "prompts"],
            "properties": {
              "tools": { "type": "boolean" },
              "resources": { "type": "boolean" },
              "prompts": { "type": "boolean" }
            }
          },
          "description": { "type": "string" },
          "security_scope": { "type": "string" },
          "common_pitfalls": { "type": "string" },
          "env": { "type": "object" }
        }
      }
    }
  }
}