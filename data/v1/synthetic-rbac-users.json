    "permission_grammar": "domain:resource:action",
    "wildcard_rules": {
      "*": "Matches any single segment (e.g., data:records:* matches read, write, and export on records)",
      "*:*:*": "Full administrative super-wildcard bypass"
    },
    "resolution_precedence": [
      "0. If resource.org_id is non-null and does not equal principal.org_id, deny all actions (cross-tenant isolation).",
      "1. If mfa.enforced is true and mfa.enrolled is false, deny all actions regardless of effective_permissions.",
      "2. If status is 'suspended' or 'pending_invite', deny all actions regardless of effective_permissions.",
      "3. If access_expires_at is non-null and earlier than reference_time, deny all actions regardless of effective_permissions.",
      "4. If last_login_at is non-null and more than dormancy_threshold_days before reference_time, deny all actions regardless of effective_permissions.",
      "5. Within workspace scope, workspace_roles overrides org_role for that workspace only.",
      "6. denied_permissions always overrides effective_permissions, even for wildcard (*:*:*) grants.",
      "7. If the requested action and an existing granted action appear together in separation_of_duty_conflicts, deny the requested action.",
      "8. Otherwise, allow if the action matches an entry in effective_permissions (exact match or wildcard segment match)."
    ],
    "dormancy_threshold_days": 90,
    "separation_of_duty_conflicts": [
      ["finance:requests:create", "finance:requests:approve"]
    ],
    "total_users": 25,
    "total_roles": 6,
    "total_resources": 8,
