  "registered_claims_dictionary": [
    {
      "claim": "iss",
      "name": "Issuer",
      "type": "StringOrURI",
      "rfc_spec": "https://datatracker.ietf.org/doc/html/rfc7519#section-4.1.1",
      "required_in": {
        "rfc7519": "optional",
        "oidc_id_token": "required",
        "rfc9068_access_token": "required"
      },
      "description": "Identifies the principal that issued the JWT, usually the authorization server's HTTPS issuer URL.",
      "security_considerations": "Compare with exact string equality against an allow-list of trusted issuers, and select verification keys per issuer, to block tokens from other identity providers."
    },
    {
      "claim": "sub",
      "name": "Subject",
      "type": "StringOrURI",
      "rfc_spec": "https://datatracker.ietf.org/doc/html/rfc7519#section-4.1.2",
      "required_in": {
        "rfc7519": "optional",
        "oidc_id_token": "required",
        "rfc9068_access_token": "required"
      },
      "description": "Identifies the principal the JWT is about, such as a user ID or service account ID.",
      "security_considerations": "Must be unique within the issuer. Key user records on iss + sub, never on email, because emails can change or be reassigned."
    },
    {
      "claim": "aud",
      "name": "Audience",
      "type": "StringOrURI or array of StringOrURI",
      "rfc_spec": "https://datatracker.ietf.org/doc/html/rfc7519#section-4.1.3",
      "required_in": {
        "rfc7519": "optional",
        "oidc_id_token": "required",
        "rfc9068_access_token": "required"
      },
      "description": "Identifies the recipients the JWT is intended for: an API identifier for access tokens, the client_id for ID tokens.",
      "security_considerations": "A resource server must reject tokens that do not list its own identifier in aud, to prevent token pass-through between APIs."
    },
    {
      "claim": "exp",
      "name": "Expiration Time",
      "type": "NumericDate (seconds since Unix epoch)",
      "rfc_spec": "https://datatracker.ietf.org/doc/html/rfc7519#section-4.1.4",
      "required_in": {
        "rfc7519": "optional",
        "oidc_id_token": "required",
        "rfc9068_access_token": "required"
      },
      "description": "The time on or after which the JWT must not be accepted for processing.",
      "security_considerations": "Keep access tokens short-lived (commonly 5 to 60 minutes). Allow only a small clock-skew leeway, typically 60 seconds or less."
    },
    {
      "claim": "nbf",
      "name": "Not Before",
      "type": "NumericDate (seconds since Unix epoch)",
      "rfc_spec": "https://datatracker.ietf.org/doc/html/rfc7519#section-4.1.5",
      "required_in": {
        "rfc7519": "optional",
        "oidc_id_token": "not_defined",
        "rfc9068_access_token": "optional"
      },
      "description": "The time before which the JWT must not be accepted for processing.",
      "security_considerations": "Reject when current_time + leeway < nbf. Useful for scheduled or deferred activation."
    },
    {
      "claim": "iat",
      "name": "Issued At",
      "type": "NumericDate (seconds since Unix epoch)",
      "rfc_spec": "https://datatracker.ietf.org/doc/html/rfc7519#section-4.1.6",
      "required_in": {
        "rfc7519": "optional",
        "oidc_id_token": "required",
        "rfc9068_access_token": "required"
      },
      "description": "The time at which the JWT was issued.",
      "security_considerations": "Lets a verifier compute token age and reject tokens issued before a password reset or session-revocation event."
    },
    {
      "claim": "jti",
      "name": "JWT ID",
      "type": "string (case-sensitive, unique per token)",
      "rfc_spec": "https://datatracker.ietf.org/doc/html/rfc7519#section-4.1.7",
      "required_in": {
        "rfc7519": "optional",
        "oidc_id_token": "not_defined",
        "rfc9068_access_token": "required"
      },
      "description": "A unique identifier for the token.",
      "security_considerations": "Enables replay detection and revocation: store seen or revoked jti values until the token's exp passes."
    }
  ],
