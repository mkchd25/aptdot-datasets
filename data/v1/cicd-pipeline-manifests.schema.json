{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.aptdot.com/data/v1/cicd-pipeline-manifests.schema.json",
  "title": "Aptdot CI/CD Pipeline & Cloud Manifest Templates",
  "type": "object",
  "required": ["metadata", "manifests"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["name", "version", "date_modified", "license", "license_url", "schema", "source", "total_manifests", "versions_checked", "validation", "description"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "date_modified": { "type": "string", "format": "date" },
        "license": { "const": "CC0-1.0" },
        "license_url": { "type": "string", "format": "uri" },
        "schema": { "type": "string", "format": "uri" },
        "source": { "type": "string", "format": "uri" },
        "total_manifests": { "type": "integer", "minimum": 1 },
        "versions_checked": { "type": "object", "required": ["date"], "properties": { "date": { "type": "string", "format": "date" } } },
        "validation": { "type": "object", "additionalProperties": { "type": "string" } },
        "description": { "type": "string" }
      }
    },
    "manifests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["id", "platform", "format", "target_file", "category", "description", "use_when", "security_highlights", "customize", "documents"],
        "properties": {
          "id": { "type": "string" },
          "platform": { "type": "string" },
          "format": { "enum": ["yaml", "json"] },
          "target_file": { "type": "string" },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "use_when": { "type": "string" },
          "security_highlights": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "customize": { "type": "array", "items": { "type": "string" } },
          "documents": { "type": "array", "minItems": 1, "items": { "type": "object" } },
          "yaml": { "type": "string" },
          "json": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "format": { "const": "yaml" } } },
            "then": { "required": ["yaml"] },
            "else": { "required": ["json"] }
          }
        ]
      }
    }
  }
}
